# Supabase — projet OpenSM partagé (xwlywozdxlgjwksypzmi)
# Tables préfixées `scrutin_` dans le schéma public. Ne pas modifier les tables existantes.
NEXT_PUBLIC_SUPABASE_URL=https://xwlywozdxlgjwksypzmi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Cron Vercel (garde de /api/cron/notify). OBLIGATOIRE : sans elle la route refuse
# — et sans la route, les scrutins échus ne se clôturent plus.
CRON_SECRET=un-secret-long-et-aleatoire

# Clé unique des routes d'écriture ouvertes aux agents : POST /api/polls et
# POST /api/polls/<token>/close. Non posée = ces routes répondent 503.
AGENT_KEY=une-autre-cle-longue-et-aleatoire
